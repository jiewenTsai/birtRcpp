# an EM for the 2PL from the components
nd <- calc_nodes(41); kap <- Y - 0.5
Fmap <- function(x) {
  a <- exp(x[1:K]); b <- x[K + 1:K]
  nw <- calc_node_weights(calc_loglik_nodes(Y, a, b, nd$z), nd$logw)
